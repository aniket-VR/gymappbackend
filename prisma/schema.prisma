// GymConnect Prisma schema.
//
// Phase 1 intentionally contains no business models. Models are added by the phase that owns
// them (users in Phase 2, gyms and tenancy in Phase 3, and so on).
//
// Conventions for every model added later:
//   - Primary keys:  id String @id @default(uuid(7)) @db.Uuid   (UUID generated by Prisma;
//                    gen_random_uuid() is available for hand-written SQL migrations)
//   - Timestamps:    DateTime @db.Timestamptz(3)                 (stored and returned in UTC)
//   - Money:         Int / BigInt named *_paise                  (integer paise, never floats)
//   - Tenant rows:   gymId (and branchId where relevant), plus composite foreign keys
//   - Table names:   snake_case via @@map, column names snake_case via @map

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
